# ============================================================================
# DGX Spark — Qwen3.8-27B serving: shared environment template
# ============================================================================
# Copy to .env and adjust for THIS host, or rely on the built-in defaults
# (every variable below has a per-file default in docker-compose.*.yml).
#
#   cp example.env .env
#   docker compose up -d                  # current prod (DFlash2); or
#   docker compose -f docker-compose.vllm.yml up -d   # rollback
#
# .env is auto-loaded by docker compose from the project directory. Only one
# stack runs at a time. The values below reproduce the CURRENT PRODUCTION
# stack (SGLang + NVFP4 + DFlash2). Alternate flavour values are in comments.

# ----------------------------------------------------------------------------
# Networking (shared by all stacks)
# ----------------------------------------------------------------------------
# Serving port. With host networking (DFlash2) this is exposed directly;
# the vLLM stacks map ${HOST_PORT}:${CONTAINER_PORT}.
HOST_PORT=8000
CONTAINER_PORT=8000
# Bind address (0.0.0.0 = reachable on the LAN; 127.0.0.1 = local only)
BIND_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Serving image (DFlash2 current prod)
# ----------------------------------------------------------------------------
# LOCAL build tag — not on any registry (see README "Obtaining the serving
# image"). Build it per host from hasso5703/dgx-spark-qwen38 install.sh:
SERVE_IMAGE=qwen38-dflash2:v1.2.2
CONTAINER_NAME=qwen38-dflash2

# ----------------------------------------------------------------------------
# HuggingFace model cache + SGLang config dir (DFlash2)
# ----------------------------------------------------------------------------
# Host path with the weights (~30 GB first download). Absolute or ~/.
HF_CACHE_HOST_DIR=~/.cache/huggingface
# Path inside the container (must match HF_HOME below)
HF_CACHE_CONTAINER_DIR=/root/.cache/huggingface
# Host dir with the patched chat template (/out) — written by install.sh:
CONFIG_HOST_DIR=~/.config/qwen38
# Host dir for SGLang's inductor/torch-compile cache (/cache):
SGLANG_CACHE_HOST_DIR=~/.config/qwen38/sglang-cache

# ----------------------------------------------------------------------------
# Model identity (each flavour has its own default)
# ----------------------------------------------------------------------------
# DFlash2 production:     RadixArk/Qwen3.8-27B-NVFP4
# vLLM+NVFP4 rollback:    unsloth/Qwen3.8-27B-NVFP4
# legacy FP8 (DeepGemm):  Qwen/Qwen3.8-27B-FP8
MODEL_ID=RadixArk/Qwen3.8-27B-NVFP4
# Served model id reported by /v1/models (whichever stack is up):
SERVED_MODEL_NAME=qwen3.8-27b

# ----------------------------------------------------------------------------
# DFlash2 speculative decoding (DFlash2 production)
# ----------------------------------------------------------------------------
DRAFT_MODEL_ID=z-lab/Qwen3.8-27B-DFlash2
# Pinned checkpoint revision (see install.sh DRAFT2_REV):
DRAFT_REV=50307d4c4cde6860d4eee73e2547cd786fe8e8a4
DRAFT_TOKENS=8

# ----------------------------------------------------------------------------
# Memory & context tuning (per-flavour defaults; override here)
# ----------------------------------------------------------------------------
# DFlash2/SGLang only (--mem-fraction-static): 0.50 — do NOT raise, see README
MEM_FRACTION_STATIC=0.5
# DFlash2 container memory cap (host cgroup; the real guard is the fraction):
MEM_LIMIT=100g
MAX_RUNNING_REQUESTS=8
# vLLM stacks (--gpu-memory-utilization): rollback 0.45, legacy FP8 0.85
# GPU_MEM_UTIL=0.45
# vLLM contexts (--max-model-len): rollback 262144, legacy 32768
# MAX_MODEL_LEN=262144
# MTP spec tokens (vLLM rollback): SPEC_TOKENS=5
# SPEC_TOKENS=5

# ----------------------------------------------------------------------------
# Stack-specific tuning (optional)
# ----------------------------------------------------------------------------
# CHUNKED_PREFILL_SIZE=8192      # SGLang
# CUDA_GRAPH_MAX_BS=8            # SGLang
# TORCH_COMPILE_MAX_BS=4         # SGLang
# MAX_MAMBA_CACHE_SIZE=96        # SGLang
# SHM_SIZE=16g                   # DFlash2 (vLLM rollback 2g, legacy 4g)

# ----------------------------------------------------------------------------
# Docker/gpu runtime (shared by all stacks)
# ----------------------------------------------------------------------------
GPU_DRIVER=nvidia
GPU_COUNT=all
RESTART_POLICY=unless-stopped
