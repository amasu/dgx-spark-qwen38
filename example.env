# ============================================================================
# DGX Spark — Qwen3.8-27B serving: shared environment template
# ============================================================================
# Copy to .env and adjust for THIS host, or rely on the built-in defaults
# (every variable below has a per-file default in docker-compose.*.yml).
#
#   cp example.env .env
#   docker compose -f docker-compose.vllm.yml up -d
#
# .env is auto-loaded by docker compose from the project directory. Only one
# stack runs at a time, so one variable set covers all three flavours —
# the values below reproduce the CURRENT PRODUCTION stack (vLLM + NVFP4 + MTP).
# Alternate flavour values are shown in comments.

# ----------------------------------------------------------------------------
# Networking (shared by all stacks)
# ----------------------------------------------------------------------------
# Host-side port exposed on the machine running Docker
HOST_PORT=8000
# In-container serving port (do not change unless you also change the flag)
CONTAINER_PORT=8000
# Bind address (0.0.0.0 = reachable on the LAN; 127.0.0.1 = local only)
BIND_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# HuggingFace model cache (shared by all stacks)
# ----------------------------------------------------------------------------
# Host path with the weights (~24 GB first download). Absolute path or ~/.
HF_CACHE_HOST_DIR=~/.cache/huggingface
# Path inside the container (must match HF_HOME below)
HF_CACHE_CONTAINER_DIR=/root/.cache/huggingface

# ----------------------------------------------------------------------------
# Model identity (shared variable; each flavour has its own default)
# ----------------------------------------------------------------------------
# vLLM+NVFP4 production:  unsloth/Qwen3.8-27B-NVFP4
# SGLang rollback:        RadixArk/Qwen3.8-27B-NVFP4
# legacy FP8 (DeepGemm):  Qwen/Qwen3.8-27B-FP8
MODEL_ID=unsloth/Qwen3.8-27B-NVFP4

# ----------------------------------------------------------------------------
# Memory & context tuning (per-flavour defaults; override here)
# ----------------------------------------------------------------------------
# vLLM stacks (--gpu-memory-utilization): prod 0.45, legacy FP8 0.85
GPU_MEM_UTIL=0.45
# SGLang only (--mem-fraction-static): 0.7
MEM_FRACTION_STATIC=0.7
# vLLM contexts (--max-model-len): prod 262144, legacy 32768
# SGLang uses the same knob as --max-total-tokens: 131072
MAX_MODEL_LEN=262144

# ----------------------------------------------------------------------------
# Speculative decoding
# ----------------------------------------------------------------------------
# Number of speculative tokens: MTP 5 (prod), DSpark 7 (legacy)
SPEC_TOKENS=5
# Draft model for the legacy DSpark stack only (prod MTP needs no draft):
# Doopeworld/Qwen3.8-27B-DSpark-vLLM
# DRAFT_MODEL_ID=Doopeworld/Qwen3.8-27B-DSpark-vLLM

# ----------------------------------------------------------------------------
# Stack-specific tuning (optional)
# ----------------------------------------------------------------------------
# MAX_NUM_SEQS=4                 # vLLM prod
# MAX_NUM_BATCHED_TOKENS=8192    # vLLM prod
# CHUNKED_PREFILL_SIZE=8192      # SGLang
# SHM_SIZE=2g                    # vLLM prod (SGLang 32g, legacy 4g)

# ----------------------------------------------------------------------------
# Docker/gpu runtime (shared by all stacks)
# ----------------------------------------------------------------------------
GPU_DRIVER=nvidia
GPU_COUNT=all
RESTART_POLICY=unless-stopped
